PATH="./bin:/usr/local/bin:/usr/local/sbin:/usr/local/git/bin:$PATH"
cdpath=($HOME/Sites $HOME/projects $HOME/repos)

export EDITOR=nvim
export VISUAL=nvim

export GPG_TTY=$(tty)

export IDF_CCACHE_ENABLE=1

export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

export PATH="$HOME/bin:$HOME/.bin:$PATH"

# Go Repos
export GOPATH=$HOME/repos/go_repos
export PATH=$PATH:$GOPATH/bin


if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# NOTE: Functions have been moved to zsh/functions/ directory.
# They are automatically loaded by ZSH when needed.

# NOTE: The laptop script does attempt to insert asdf into this file but it ties
# to a specific user and doesn't include completions. Perhaps best to include
# it here directly instead of relying on the laptop script. Reference:
#
# https://asdf-vm.com/#/core-manage-asdf-vm
# . /opt/homebrew/opt/asdf/libexec/asdf.sh
# Current asdf uses shims; older installs may also have a completions directory.
# Prefer standalone tools (Claude's native installer and pipx) to old npm shims.
export PATH="$HOME/.local/bin:${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
[[ -n ${ASDF_DIR:-} && -d "$ASDF_DIR/completions" ]] && fpath=("$ASDF_DIR/completions" $fpath)
autoload -Uz compinit
compinit

# Optional machine/work settings from the private companion repository.
[[ -f ~/.zshrc.private ]] && source ~/.zshrc.private

# Git signing uses ssh-agent without SSH's per-host UseKeychain settings.
# Restore saved keys only to Apple's local agent, never a forwarded/custom agent.
if [[ -o interactive && $OSTYPE == darwin* &&
      ${SSH_AUTH_SOCK:-} == (/private|)(/tmp|/var/run)/com.apple.launchd.*/Listeners ]]; then
  SSH_ASKPASS_REQUIRE=never /usr/bin/ssh-add --apple-load-keychain </dev/null >/dev/null 2>&1 || true
fi

[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
