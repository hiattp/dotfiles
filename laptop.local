#!/bin/bash

# This file is sourced by the reviewed thoughtbot bootstrap.
set -e
set -o pipefail

ensure_git_checkout() {
  local repo_src=$1 repo_dir=$2
  if [ ! -d "$repo_dir/.git" ]; then
    git clone --recursive "$repo_src" "$repo_dir"
  else
    fancy_echo "Using existing checkout at %s (no automatic pull)" "$repo_dir"
  fi
}

brew bundle --file=- <<EOF
tap "azure/functions"
tap "teamookla/speedtest"
tap "fluxcd/tap"
brew "neovim"
brew "git"
brew "gh"
brew "gnupg"
brew "rcm"
brew "asdf"
brew "python"
brew "go"
brew "rust"
brew "dotnet"
brew "fzf"
brew "coreutils"
brew "shellcheck"
brew "actionlint"
brew "universal-ctags"
brew "krb5" # Kerberos: kinit, klist, kdestroy (keg-only on macOS)
brew "mkcert"
brew "poppler"
brew "tesseract"
brew "watchman"
brew "yarn"
brew "pnpm"
cask "1password-cli"
cask "codex"
brew "ripgrep"
brew "overmind"
brew "vips"
brew "awscli"
brew "sops"
brew "kubernetes-cli"
brew "clusterctl"
brew "helm"
brew "kind"
brew "step"
brew "fluxcd/tap/flux", trusted: true
brew "argocd"
brew "pipx"
brew "uv"
cask "azure-cli"
brew "azure/functions/azure-functions-core-tools@4", trusted: true
brew "watch"
brew "jq"
brew "yq"
brew "eksctl"
brew "certbot"
brew "teamookla/speedtest/speedtest", trusted: true
brew "cmctl"
brew "iperf3"
brew "cmake"
brew "ninja"
brew "dfu-util"
brew "ccache"
brew "sdl2-compat"
brew "notation"
brew "licensed"
brew "git-lfs"
cask "tailscale-app"
cask "balenaetcher"
cask "iterm2"
cask "google-chrome"
cask "github"
cask "dropbox"
cask "1password"
cask "karabiner-elements"
cask "openvpn-connect"
cask "slack"
cask "discord"
cask "docker-desktop"
cask "spotify"
cask "zoom"
cask "parallels"
cask "visual-studio-code"
cask "postman"
cask "raycast"
cask "lens"
EOF

# Claude Code native installer; Codex is installed by Homebrew above.
curl -fsSL https://claude.ai/install.sh | bash

# Use asdf for Ruby, Node, and Terraform. Other general-purpose runtimes above
# follow Homebrew's current stable versions; project-specific pins stay local.
add_or_update_asdf_plugin "ruby" "https://github.com/asdf-vm/asdf-ruby.git"
add_or_update_asdf_plugin "nodejs" "https://github.com/asdf-vm/asdf-nodejs.git"
add_or_update_asdf_plugin "terraform" "https://github.com/asdf-community/asdf-hashicorp.git"
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$HOME/.local/bin:$PATH"

install_asdf_default() {
  local plugin=$1 version=$2
  if ! printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    printf 'Cannot select a stable %s version: %s\n' "$plugin" "$version" >&2
    return 1
  fi
  asdf install "$plugin" "$version"
  asdf set --home "$plugin" "$version"
}

install_asdf_default ruby "$(asdf latest ruby)"
# Resolve a full release from Node's official index, rather than its Current line.
node_lts=$(curl -fsSL https://nodejs.org/dist/index.json | jq -r '[.[] | select(.lts != false)][0].version | ltrimstr("v")')
install_asdf_default nodejs "$node_lts"
install_asdf_default terraform "$(asdf latest terraform)"
asdf reshim

# Browser automation CLI for coding agents, installed for the selected Node LTS.
npm install --global @playwright/cli@latest
asdf reshim nodejs

fancy_echo "Cleaning up old Homebrew formulae ..."
brew cleanup

ensure_git_checkout "https://github.com/thoughtbot/dotfiles.git" "$HOME/.thoughtbot-dotfiles"
ensure_git_checkout "https://github.com/hiattp/dotfiles.git" "$HOME/.hiattp-dotfiles"
# rcrc may already be a symlink to this file on an existing machine.
if [ ! "$HOME/.hiattp-dotfiles/rcrc" -ef "$HOME/.rcrc" ]; then
  cp "$HOME/.hiattp-dotfiles/rcrc" "$HOME/.rcrc"
fi

mkdir -p "$HOME/.config/karabiner/assets/complex_modifications"
curl \
  -fsS \
  -o ~/.config/karabiner/assets/complex_modifications/escape_multifunction.json \
  'https://gist.githubusercontent.com/hiattp/e4b2c8b04a6db4f531264ca759e0d2ab/raw/00d0bc6c75fd09074f37a6d06c7cc609bca03fd7/escape_multifunction.json'

# Git LFS
git lfs install

#
# Install Go-based packages/binaries:
#

# This is an interactive wrapper for jq:
go install github.com/fiatjaf/jiq/cmd/jiq@latest

# Install awsume (https://awsu.me/) to facilitate AWS IAM role adoption (and
# other python-based CLI tools via pipx):
pipx completions
pipx install awsume --force
pipx install poetry --force

# If you need ctags (not necessary if using a language server):
# gem_install_or_update "gem-ctags"

if [ -r "$HOME/.rcrc" ]; then
  fancy_echo "Updating dotfiles ..."
  rcup -K
fi

# Optional companion installs (clone the private repository before running setup).
if [ -r "$HOME/.laptop.private" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.laptop.private"
elif [ -r "$HOME/.hiattp-dotfiles-private/laptop.private" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.hiattp-dotfiles-private/laptop.private"
fi
