{
  "d.": {
    "prefix": "d.",
    "body": [
      "<div class=\"$1\">",
      "\t$2",
      "</div>"
    ],
    "description": "HTML.ERB - Defines a section in a document with a class"
  },
  "end": {
    "prefix": "end",
    "body": [
      "<% end %>"
    ],
    "description": "Easily add an end statement."
  },
  "%": {
    "prefix": "%",
    "body": [
      "<% $0 %>"
    ],
    "description": "Add basic ruby block/segment."
  }
}
