[user]
  name = Paul Hiatt
  email = hiattp@gmail.com
[core]
  editor = nvim
  untrackedCache = true
[credential]
  helper = osxkeychain
[alias]
  di = diff
  br = branch
  sta = stash
[pull]
  ff = only
[filter "media"]
  clean = git-media-clean %f
  smudge = git-media-smudge %f
[include]
  path = ~/.gitconfig.private
